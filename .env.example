# RevCRM Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-revcrm --about` for the
# authoritative list.

# Required: Auth0 machine-to-machine credentials
TAP_REVCRM_CLIENT_ID=your_client_id_here
TAP_REVCRM_CLIENT_SECRET=your_client_secret_here
TAP_REVCRM_CLIENT_CODE=your_revcrm_client_code_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_REVCRM_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://app.roicrm.net/api/1.0)
TAP_REVCRM_API_URL=https://app.roicrm.net/api/1.0

# Required: A RevCRM donor search object. The API rejects unfiltered requests.
TAP_REVCRM_SEARCH_PARAMETERS='{"account-flag":"MEMBER"}'
